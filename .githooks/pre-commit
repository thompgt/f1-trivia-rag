#!/usr/bin/env bash
# Runs the offline test suite before allowing a commit.
#
# `live`-marked tests are excluded: they call the real Gemini API, so they cost
# money, need network, and are non-deterministic - not something a commit should
# depend on. Run them explicitly with `pytest -m live`.
#
# Installed via: git config core.hooksPath .githooks
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

PYTHON_BIN=".venv/Scripts/python"
[ -x "$PYTHON_BIN" ] || PYTHON_BIN=".venv/bin/python"

if [ ! -x "$PYTHON_BIN" ]; then
    echo "pre-commit: no .venv found. Create one with:" >&2
    echo "  python -m venv .venv && .venv/Scripts/pip install -e \".[dev]\"" >&2
    exit 1
fi

echo "pre-commit: running ruff..."
if ! "$PYTHON_BIN" -m ruff check .; then
    echo "pre-commit: lint failed - commit aborted." >&2
    exit 1
fi

echo "pre-commit: running offline tests..."
if ! "$PYTHON_BIN" -m pytest -q -m "not live"; then
    echo "pre-commit: tests failed - commit aborted." >&2
    exit 1
fi

echo "pre-commit: all offline checks passed."
